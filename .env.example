# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App
NEXT_PUBLIC_SITE_URL=https://teranga-spot.com
NEXT_PUBLIC_SITE_NAME=TerangaSpot
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=TerangaSpot

# Super Admin (used only in seed script, never in frontend)
# SEED_SUPER_ADMIN_EMAIL=rokhayagueye0330@gmail.com
# SEED_SUPER_ADMIN_PASSWORD=set-via-supabase-dashboard

# SMTP — envoi des emails transactionnels (mot de passe partagé boutique)
SMTP_HOST=mail.teranga-spot.com
SMTP_PORT=465
SMTP_USER=contact@teranga-spot.com
SMTP_PASS=your-mailbox-password-here

# Chiffrement au repos du mot de passe partagé — 32 octets en base64
# Générer avec : openssl rand -base64 32
APP_ENCRYPTION_KEY=your-32-byte-base64-key-here

# Secret partagé avec Vercel Cron pour authentifier /api/cron/generate-invoices
# (Vercel envoie automatiquement "Authorization: Bearer $CRON_SECRET")
# Générer avec : openssl rand -base64 32
CRON_SECRET=your-cron-secret-here
